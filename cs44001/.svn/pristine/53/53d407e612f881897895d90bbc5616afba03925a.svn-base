// roster that works with map<Student, list<string>> - way more efficient
// Mikhail Nesterenko - Modified by: Austin Sternberg
// 2/14/2025

#include <fstream>
#include <iostream>
#include <vector>
#include <list>
#include <string>
#include <cstdlib>
#include <map>

using std::ifstream;
using std::string; using std::getline;
using std::list; using std::vector;
using std::cout; using std::endl;
using std::move; using std::map;
using std::string;


class Student{
public:
   Student(string firstName, string lastName): 
      firstName_(firstName), lastName_(lastName) {}
 
   // move constructor, not really needed, generated automatically
   Student(Student && org) noexcept:
      firstName_(move(org.firstName_)),
      lastName_(move(org.lastName_))
   {}
  
   // force generation of default copy constructor
   Student(const Student & org) = default;
   
  string print() const {return firstName_ + ' ' + lastName_;}

    // needed for unique() and for remove()
   friend bool operator== (Student left, Student right){
      return left.lastName_ == right.lastName_ &&
	     left.firstName_ == right.firstName_;
   }

   // needed for sort()
   friend bool operator< (Student left, Student right){
      return left.firstName_ < right.firstName_ ||
	     (left.firstName_ == right.firstName_ && 
	      left.lastName_ < right.lastName_);
   }
private:
   string firstName_;
   string lastName_;
};



// reading a map from a fileName
void readRoster(map<Student, list<string>>& roster, string fileName);
// reading a list from a fileName
void readRoster(list<Student>& roster, string fileName);
// Remove Dropouts
void removeDropouts(map<Student, list<string>>&, const list<Student>& dropouts);
// printing a list out
void printRoster(const map<Student, list<string>>& roster); 

int main(int argc, char* argv[]){

   if (argc <= 1){ cout << "usage: " << argv[0] 
      << " list of courses, dropouts last" << endl; exit(1);}

   map<Student, list<string>> courseStudents; 

   for(int i=1; i < argc-1; ++i){
      readRoster(courseStudents, argv[i]); 
   }

   // reading in dropouts
   list<Student> dropouts; 
   readRoster(dropouts, argv[argc-1]); 
   
   removeDropouts(courseStudents, dropouts); // removing dropouts
   
   // printing the final roster
   cout << "all students, dropouts removed \n";
   cout << "first name last name: courses enrolled\n";
   printRoster(courseStudents);

}

// reading a map from a fileName
void readRoster(map<Student, list<string>>& courseStudents, string fileName){
   ifstream course(fileName);
   string first, last, courseName;
   
   // Extract course name from filename
   int pos = fileName.find('.');
   if (pos != -1) { // If pos is -1, the file name does not contain a period
      courseName = fileName.substr(0, pos);
   }

   while(course >> first >> last){
      Student student(first, last);
      courseStudents[student].push_back(courseName);
   }

   course.close();
}

// reading a list from a fileName
void readRoster(list<Student>& roster, string fileName){
   ifstream course(fileName);
   string first, last;
   while(course >> first >> last)
      roster.push_back(Student(first, last));
   course.close();
}

// Remove Dropouts
void removeDropouts(map<Student, list<string>>& courseStudents, const list<Student>& dropouts){
   for(const auto& student : dropouts)
      courseStudents.erase(student);
}

// printing a list out
void printRoster(const map<Student, list<string>>& courseStudents){
   for(const auto& student : courseStudents) {
      cout << student.first.print() << ": ";
      for (const auto& course : student.second) cout << course << ' ';
      cout << endl;
   }
}