#include "WordList.hpp"
#include <iostream>
#include <string>
#include <cstring>

bool WordOccurrence::matchWord(const std::string &word) {
    return word_ == word;
}

void WordOccurrence::increment() {
    num_++;
}

std::string WordOccurrence::getWord() const {
    return word_;
}

int WordOccurrence::getNum() const {
    return num_;
}

WordList::WordList(WordOccurrence *wordArray, int size) : wordArray_(wordArray), size_(size) {};

WordList WordList::operator=(const WordList &other) {
    WordList temp;
    swap(*this, temp);
    return *this;
}

WordList::WordList(const WordList &other) {
    size_ = other.size_;
    wordArray_ = new WordOccurrence[size_];
    for (int i = 0; i < size_; i++) {
        wordArray_[i] = other.wordArray_[i];
    }
}

WordList::~WordList() {
    delete[] wordArray_;
}

WordList& swap(WordList &lhs, WordList &rhs) {
    WordOccurrence *temp;
    temp = lhs.wordArray_;
    lhs.wordArray_ = rhs.wordArray_;
    rhs.wordArray_ = temp;

    int tempSize;
    tempSize = lhs.size_;
    lhs.size_ = rhs.size_;
    rhs.size_ = tempSize;

    return lhs;
}

bool equal(const WordList &lhs, const WordList &rhs) {
    if (lhs.size_ != rhs.size_) return false;
    for (int i = 0; i < lhs.size_; i++) {
        if (lhs.wordArray_[i].getWord() != rhs.wordArray_[i].getWord()) {return false;}
        if (lhs.wordArray_[i].getNum() != rhs.wordArray_[i].getNum()) {return false;}

    }
    return true;
}

void WordList::addWord(const std::string &word) {
    size_++;
    WordOccurrence *temp = new WordOccurrence[size_];
    for (int i = 0; i < size_ - 1; i++) {
        temp[i] = wordArray_[i];
    }
    temp[size_ - 1] = WordOccurrence(word, 1);
    delete[] wordArray_;
    wordArray_ = temp;
}

void WordList::print() {
    for (int i = 0; i < size_; i++) {
        std::cout << wordArray_[i].getWord() << " " << wordArray_[i].getNum() << std::endl;
    }
}