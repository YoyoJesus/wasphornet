#include <iostream>
#include <string>
#include <fstream>

using std::cout; using std::endl;
using std::string;

class Logger {
public:
    // Meyer's singleton - way easier to implement
    static Logger& instance () {
        static Logger log;
        return log;
    }

    void report(const string &append) {
        file << append << std::endl;
    }

    ~Logger() {
        cout << "Logger destroyed" << endl;
        file.close();
    }

    // delete copy constructor and assignment operator - force singleton
    Logger& operator=(const Logger&) = delete;
    Logger(const Logger&) = delete;
private:
    Logger() {
        cout << "Logger created" << endl;
    }

    // making the file stream private - singleton won't cause file to be opened multiple times
    std::ofstream file{"log.txt", std::ios::app};
};

int main() {
    Logger::instance().report("UTC: 2021-04-01 12:00:00 - Incident: 1234");
    Logger::instance().report("UTC: 2021-04-01 12:00:01 - Incident: 1235");
    Logger::instance().report("UTC: 2021-04-01 12:00:02 - Incident: 1236");
    return 0;
}