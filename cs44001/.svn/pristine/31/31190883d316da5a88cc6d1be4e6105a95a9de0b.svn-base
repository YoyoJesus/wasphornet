PROCEDURAL_EXEC = roster
OBJECT_EXEC = rosterObject
INPUT_FILES = cs1.txt cs2.txt cs3.txy cs4.txt dropouts
OUTPUT_FILE = output.txt

procedural:
	g++ -o $(PROCEDURAL_EXEC) roster.cpp
	./$(PROCEDURAL_EXEC) $(INPUT_FILES)

object:
	g++ -o $(OBJECT_EXEC) rosterObject.cpp
	./$(OBJECT_EXEC) $(INPUT_FILES)

run_procedural:
	rm -f $(OUTPUT_FILE)
	g++ -o $(PROCEDURAL_EXEC) roster.cpp
	echo "Running Procedural Version:" > $(OUTPUT_FILE)
	./$(PROCEDURAL_EXEC) $(INPUT_FILES) >> $(OUTPUT_FILE)

run_object:
	rm -f $(OUTPUT_FILE)
	g++ -o $(OBJECT_EXEC) rosterObject.cpp
	echo "Running Object-Oriented Version:" >> $(OUTPUT_FILE)
	./$(OBJECT_EXEC) $(INPUT_FILES) >> $(OUTPUT_FILE)

test_procedural: $(PROCEDURAL_EXEC)
	valgrind ./$(PROCEDURAL_EXEC)

test_object: $(OBJECT_EXEC)
	valgrind ./$(OBJECT_EXEC)

$(PROCEDURAL_EXEC): roster.cpp
	g++ -o $(PROCEDURAL_EXEC) roster.cpp

$(OBJECT_EXEC): rosterObject.cpp
	g++ -o $(OBJECT_EXEC) rosterObject.cpp

clean:
	rm -f $(PROCEDURAL_EXEC) $(OBJECT_EXEC) $(OUTPUT_FILE)
