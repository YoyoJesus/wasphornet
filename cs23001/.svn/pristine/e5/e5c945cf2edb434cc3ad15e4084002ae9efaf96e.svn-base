//  Stack class test program
//
//  Tests: copy ctor
//

#include "stack.hpp"
#include <cassert>
#include <iostream>

//===========================================================================
int main ()
{
    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<int>  x;
        x.push(1);

        stack<int> x2(x);

        // VERIFY
        assert(x.top() == x.top());
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<char>  x;
        x.push('c');

        stack<char> x2(x);

        // VERIFY
        assert(x.top() == x.top());
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<String>  x;
        x.push("23");

        stack<String> x2(x);

        // VERIFY
        assert(x.top() == x.top());
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<int>  x;
        x.push(1000000000000000);
        x.push(12345678900987659889);

        stack<int> x2(x);

        // VERIFY
        assert(x.top() == x.top());
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<char>  x;
        x.push('d');
        x.push('e');

        stack<char> x2(x);

        // VERIFY
        assert(x.top() == x.top());
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<String>  x;
        x.push("2323233232323232323232323232232323223232332323232323232323323232323232323232322223223222323232232223232232323232322");
        x.push("123456789009876543211234567890098765432234567899876543223456789876543223456789");

        stack<String> x2(x);

        // VERIFY
        assert(x.top() == x.top());
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<int> x;
        for (int i = 0; i <= 1000; ++i){
            x.push(i);
            assert(x.top() == i);
        }

        stack<int> x2(x);


        for (int i = 1000; i >= 0; --i) {
            assert(x.pop() == x2.pop());
        }

        // VERIFY
        assert(x.empty() == true);
        assert(x2.empty() == true);
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<char> x;
        for (int i = 0; i <= 1000; ++i){
            x.push(i);
            assert(x.top() == i);
        }

        stack<char> x2(x);


        for (int i = 1000; i >= 0; --i) {
            assert(x.pop() == x2.pop());
        }

        // VERIFY
        assert(x.empty() == true);
        assert(x2.empty() == true);
    }


    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<String> x;
        for (int i = 0; i <= 1000; ++i){
            x.push(i * i);
            assert(x.top() == (i * i));
        }

        stack<String> x2(x);


        for (int i = 1000; i >= 0; --i) {
            assert(x.pop() == x2.pop());
        }

        // VERIFY
        assert(x.empty() == true);
        assert(x2.empty() == true);
    }
    
    std::cout << "Done testing copy ctor." << std::endl;
    return 0;
}