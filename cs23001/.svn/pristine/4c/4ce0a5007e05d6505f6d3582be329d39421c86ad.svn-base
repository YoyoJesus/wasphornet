//This file contains more tests for the challenge of the bigint project
#include "bigint.hpp"

int main() {
    //factorial of 100
    bigint factorial;
    factorial = factorial.nfact(100); // Calculate 100!

    int zeroCount;
    zeroCount = factorial.trailingZeros(); // Count trailing zeros

    std::cout << "Factorial of 100: " << factorial << std::endl;
    std::cout << "Trailing zeros in 100!: " << zeroCount << std::endl;

    //factorial of 200
    factorial = factorial.nfact(200); // Calculate 200!

    zeroCount = factorial.trailingZeros(); //Count trailing zeros

    std::cout << "Factorial of 200: " << factorial << std::endl;
    std::cout << "Trailing zeros in 200!: " << zeroCount << std::endl;

    //factorial of 300
    factorial = factorial.nfact(300); // Calculate 300!

    zeroCount = factorial.trailingZeros(); //Count trailing zeros

    std::cout << "Factorial of 300: " << factorial << std::endl;
    std::cout << "Trailing zeros in 300!: " << zeroCount << std::endl;

    //factorial of 400
    factorial = factorial.nfact(400); // Calculate 400!

    zeroCount = factorial.trailingZeros(); //Count trailing zeros

    std::cout << "Factorial of 400: " << factorial << std::endl;
    std::cout << "Trailing zeros in 400!: " << zeroCount << std::endl;

    //factorial of 26
    factorial = factorial.nfact(26); // Calculate 26!

    zeroCount = factorial.trailingZeros(); //Count trailing zeros

    std::cout << "Factorial of 26: " << factorial << std::endl;
    std::cout << "Trailing zeros in 26!: " << zeroCount << std::endl;
}