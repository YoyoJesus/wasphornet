//This file contains the test code for the class 'object'

#include "object_construction.hpp"

int main() {
    Object one; //Test Default ctor
    Object two; //Test Default ctor

    one = two; //Test Overload Assignment
    two = one; //Test Overload Assignment

    Object new_two(two); //Test copy ctor
    Object new_one(one); //Test copy ctor

    //all four objects are deleted under a dtor call when they go out of scope

    return 0;
}