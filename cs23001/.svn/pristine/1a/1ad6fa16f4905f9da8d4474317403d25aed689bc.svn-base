//  Stack class test program
//
//  Tests: assignment operator
//

#include "stack.hpp"
#include <cassert>
#include <iostream>

//===========================================================================
int main ()
{
    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<int>  x;
        x.push(1);

        stack<int> x2;
        x2 = x;

        // VERIFY
        assert(x.empty() == false);
        assert(x2.empty() == false);
        assert(x.top() == x.top());
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<char>  x;
        x.push('c');

        stack<char> x2;
        x2 = x;
        
        // VERIFY
        assert(x.empty() == false);
        assert(x2.empty() == false);
        assert(x.top() == x.top());
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<String>  x;
        x.push("23");

        stack<String> x2;
        x2 = x;
        
        // VERIFY
        assert(x.empty() == false);
        assert(x2.empty() == false);
        assert(x.top() == x.top());
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<int>  x;
        x.push(1);

        stack<int> x2;
        x2 = x;

        x2.pop();
        x.pop();

        // VERIFY
        assert(x.empty() == true);
        assert(x2.empty() == true);
        assert(x.top() == x.top());
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<char>  x;
        x.push('c');

        stack<char> x2;
        x2 = x;

        x2.pop();
        x.pop();

        // VERIFY
        assert(x.empty() == true);
        assert(x2.empty() == true);
        assert(x.top() == x.top());
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<String>  x;
        x.push("23");

        stack<String> x2;
        x2 = x;

        x2.pop();
        x.pop();

        // VERIFY
        assert(x.empty() == true);
        assert(x2.empty() == true);
        assert(x.top() == x.top());
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<int> x;
        for (int i = 0; i <= 1000; ++i){
            x.push(i);
            assert(x.top() == i);
        }

        stack<int> x2;
        x2 = x;


        for (int i = 1000; i >= 0; --i) {
            assert(x.pop() == x2.pop());
        }

        // VERIFY
        assert(x.empty() == true);
        assert(x2.empty() == true);
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<char> x;
        for (int i = 0; i <= 1000; ++i){
            x.push(i);
            assert(x.top() == i);
        }

        stack<char> x2;
        x2 = x;


        for (int i = 1000; i >= 0; --i) {
            assert(x.pop() == x2.pop());
        }

        // VERIFY
        assert(x.empty() == true);
        assert(x2.empty() == true);
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<String> x;
        for (int i = 0; i <= 1000; ++i){
            x.push(i * i);
            assert(x.top() == (i * i));
        }

        stack<String> x2;
        x2 = x;


        for (int i = 1000; i >= 0; --i) {
            assert(x.pop() == x2.pop());
        }

        // VERIFY
        assert(x.empty() == true);
        assert(x2.empty() == true);
    }

    std::cout << "Done testing assignment." << std::endl;
    return 0;
}