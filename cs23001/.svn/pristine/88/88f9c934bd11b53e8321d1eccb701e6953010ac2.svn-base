//  Stack class test program
//
//  Tests: push pop
//

#include "stack.hpp"
#include <cassert>
#include <iostream>

//===========================================================================
int main ()
{
    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<int>  x;
        x.push(1);

        // VERIFY
        assert(x.empty() == false);
        assert(x.top() == 1);
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<int>  x;
        x.push(1);
        x.pop();

        // VERIFY
        assert(x.empty() == true);
        assert(x.full() == false);
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<char>  x;
        x.push('c');

        // VERIFY
        assert(x.empty() == false);
        assert(x.top() == 1);
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<char>  x;
        x.push('c');
        x.pop();

        // VERIFY
        assert(x.empty() == true);
        assert(x.full() == false);
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<String>  x;
        x.push("23");

        // VERIFY
        assert(x.empty() == false);
        assert(x.top() == 1);
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<String>  x;
        x.push("23");
        x.pop();

        // VERIFY
        assert(x.empty() == true);
        assert(x.full() == false);
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<int> x;
        for (int i = 0; i <= 1000; ++i){
            x.push(i);
            assert(x.top() == i);
        }

        for (int i = 1000; i >= 0; --i) {
            assert(x.pop() == i);
        }

        // VERIFY
        assert(x.empty() == true);
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<char> x;
        for (int i = 0; i <= 1000; ++i){
            x.push(i);
            assert(x.top() == i);
        }

        for (int i = 1000; i >= 0; --i) {
            assert(x.pop() == i);
        }

        // VERIFY
        assert(x.empty() == true);
    }

    {
        //------------------------------------------------------
        // SETUP FIXTURE

        // TEST
        stack<String> x;
        for (int i = 0; i <= 1000; ++i){
            x.push(i * i);
            assert(x.top() == (i * i));
        }

        for (int i = 1000; i >= 0; --i) {
            assert(x.pop() == (i * i));
        }

        // VERIFY
        assert(x.empty() == true);
    }
    
    std::cout << "Done testing push pop." << std::endl;
    return 0;
}